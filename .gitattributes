# 统一用 LF。Windows 上 core.autocrlf=true 会把 checkout 出来的文件转成 CRLF，
# 带 CRLF 的 shell 脚本 shebang 会变成 "#!/bin/sh\r"，执行时报 bad interpreter。
* text=auto eol=lf

# 这两类必须是 LF，属于硬要求而非风格偏好
*.sh text eol=lf
templates/githooks/* text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
